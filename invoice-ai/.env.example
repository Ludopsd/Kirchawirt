# Datenbank
DATABASE_URL="postgresql://invoice_ai:invoice_ai@localhost:5432/invoice_ai?schema=public"

# Session/Login (zufälligen langen String erzeugen, z.B. mit: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic Claude API (für die Rechnungs-Extraktion) — echten Key hier eintragen
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Dateispeicher: "local" (Default, Ordner auf der Platte/im Docker-Volume — NICHT geeignet für Vercel,
# da dort kein dauerhaftes Dateisystem existiert) oder "vercel-blob" (für Deployments auf Vercel; benötigt
# BLOB_READ_WRITE_TOKEN, wird automatisch gesetzt sobald im Vercel-Projekt ein Blob Store verbunden ist)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/invoices"

# Einmalige Einrichtung per Browser-Aufruf ohne Terminal (z.B. für Vercel-Deployments):
# /api/setup?token=<SETUP_TOKEN> legt Admin-Login + Beispiel-Stammdaten an. Nur aktiv wenn gesetzt —
# nach der Einrichtung wieder entfernen (Umgebungsvariable löschen, danach neu deployen).
SETUP_TOKEN=""

# SAP-Anbindung: "export" (Default, erzeugt SAP-fähige CSV-Datei, kein Live-Zugang nötig)
# oder "odata" (echte S/4HANA OData-Schnittstelle, sobald Zugangsdaten vorliegen)
SAP_CONNECTOR="export"
SAP_ODATA_BASE_URL=""
SAP_ODATA_USERNAME=""
SAP_ODATA_PASSWORD=""

# Firmenbuchungskreis, wird beim SAP-Export als BUKRS mitgegeben
SAP_COMPANY_CODE="1000"
