# Datenbank
DATABASE_URL="postgresql://invoice_ai:invoice_ai@localhost:5432/invoice_ai?schema=public"

# Session/Login (zufälligen langen String erzeugen, z.B. mit: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic Claude API (für die Rechnungs-Extraktion) — echten Key hier eintragen
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Dateispeicher: "local" (Default, Ordner auf der Platte) oder "s3" (S3-kompatibel)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/invoices"
# Nur nötig wenn STORAGE_DRIVER=s3:
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# SAP-Anbindung: "export" (Default, erzeugt SAP-fähige CSV-Datei, kein Live-Zugang nötig)
# oder "odata" (echte S/4HANA OData-Schnittstelle, sobald Zugangsdaten vorliegen)
SAP_CONNECTOR="export"
SAP_ODATA_BASE_URL=""
SAP_ODATA_USERNAME=""
SAP_ODATA_PASSWORD=""

# Firmenbuchungskreis, wird beim SAP-Export als BUKRS mitgegeben
SAP_COMPANY_CODE="1000"
