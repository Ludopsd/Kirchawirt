generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AP_CLERK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(AP_CLERK)
  createdAt    DateTime @default(now())

  uploadedInvoices  Invoice[] @relation("UploadedBy")
  confirmedInvoices Invoice[] @relation("ConfirmedBy")
}

model Supplier {
  id                String   @id @default(cuid())
  name              String
  normalizedName    String
  aliases           String[] @default([])
  ibans             String[] @default([])
  taxId             String?
  vatId             String?
  kreditorenkonto   String
  defaultSachkonto  String?
  street            String?
  postalCode        String?
  city              String?
  country           String   @default("DE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoices Invoice[]

  @@index([normalizedName])
}

model ChartOfAccountsEntry {
  id            String  @id @default(cuid())
  accountNumber String  @unique
  accountName   String
  accountType   String
  isActive      Boolean @default(true)
}

enum InvoiceStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  PENDING_REVIEW
  CONFIRMED
  BOOKED
  SAP_ERROR
}

model Invoice {
  id               String        @id @default(cuid())
  originalFileName String
  storagePath      String
  mimeType         String
  pageCount        Int           @default(1)
  status           InvoiceStatus @default(UPLOADED)

  uploadedByUserId String
  uploadedBy       User   @relation("UploadedBy", fields: [uploadedByUserId], references: [id])

  matchedSupplierId       String?
  matchedSupplier         Supplier? @relation(fields: [matchedSupplierId], references: [id])
  supplierMatchConfidence Float?
  supplierMatchMethod     String?

  vendorName    String?
  invoiceNumber String?
  invoiceDate   DateTime?
  dueDate       DateTime?
  currency      String    @default("EUR")
  grossAmount   Decimal?  @db.Decimal(12, 2)
  netAmount     Decimal?  @db.Decimal(12, 2)
  iban          String?
  taxId         String?

  kreditorenkonto String?
  sachkonto       String?

  sapDocumentNumber String?
  sapErrorMessage   String?

  extractionRaw   Json?
  extractionError String?
  aiNotes         String?

  createdAt       DateTime  @default(now())
  extractedAt     DateTime?
  confirmedAt     DateTime?
  confirmedByUserId String?
  confirmedBy     User?     @relation("ConfirmedBy", fields: [confirmedByUserId], references: [id])
  bookedAt        DateTime?

  vatEntries  InvoiceVatEntry[]
  lineItems   InvoiceLineItem[]
  fields      ExtractedField[]
  sapExports  SapExportRecord[]

  @@index([status])
}

model InvoiceVatEntry {
  id         String  @id @default(cuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rate       Decimal @db.Decimal(5, 2)
  netAmount  Decimal @db.Decimal(12, 2)
  vatAmount  Decimal @db.Decimal(12, 2)
  taxCode    String?
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  sachkonto   String?
  sortOrder   Int     @default(0)
}

enum BoundingBoxSource {
  NONE
  LLM_APPROXIMATE
  OCR_MATCHED
}

enum BoundingBoxConfidence {
  NONE
  LOW
  MEDIUM
  HIGH
}

model ExtractedField {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fieldName   String
  rawValue    String
  confidence  Float?
  pageNumber  Int      @default(1)

  boxX      Float?
  boxY      Float?
  boxWidth  Float?
  boxHeight Float?

  boundingBoxSource     BoundingBoxSource     @default(NONE)
  boundingBoxConfidence BoundingBoxConfidence @default(NONE)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum SapConnectorType {
  EXPORT_CSV
  ODATA
}

enum SapExportStatus {
  SUCCESS
  FAILED
}

model SapExportRecord {
  id                String           @id @default(cuid())
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  connectorType     SapConnectorType
  status            SapExportStatus
  requestPayload    Json
  responsePayload   Json?
  sapDocumentNumber String?
  errorMessage      String?
  createdAt         DateTime         @default(now())
}
